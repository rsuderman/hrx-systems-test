// SystemOne decision control for the LiquidAI d1 (lfm3) GGUF. Each question is
// rendered with the GGUF "systemone" chat template exactly as llama.cpp's
// server-decision.cpp does (state, instructions, options, label codes; text
// values have special-token spellings broken by a zero-width space; non-string
// values are JSON with Python json.dumps separators), tokenized with special
// token matching, and paired with its option label-token groups.
func.decl import("input") @encode(%text: buffer, %flags: i32, %capacity: i64) -> (buffer, i64)

func.decl import("input") @require(%condition: i32, %diagnostic: buffer)

func.decl import("json") @compact(%json: buffer) -> (buffer)

func.decl import("json") @unescape(%source: buffer, %offset: i64, %length: i64, %target: buffer, %target_offset: i64) -> (i64)

func.decl import("runner") @execute_2(%stage: i32, %input: hal.buffer, %output: hal.buffer) -> (i64)

