  %bytes = scalar.muli %index, %c8 : i64
  %o = func.call @off(%bytes) : (i64) -> (offset)
  %v = buffer.view %buf[%o] : buffer -> view<1xi64>
  %x = view.load %v[0] : view<1xi64> -> i64
  func.return %x : i64
}

func.def @i64_b(%buf: buffer, %bytes: i64) -> (i64) {
  %o = func.call @off(%bytes) : (i64) -> (offset)
  %v = buffer.view %buf[%o] : buffer -> view<1xi64>
  %x = view.load %v[0] : view<1xi64> -> i64
  func.return %x : i64
}

func.def @i32_b(%buf: buffer, %bytes: i64) -> (i32) {
  %o = func.call @off(%bytes) : (i64) -> (offset)
  %v = buffer.view %buf[%o] : buffer -> view<1xi32>
  %x = view.load %v[0] : view<1xi32> -> i32
  func.return %x : i32
}

func.def @set_i32(%buf: buffer, %index: i64, %value: i32) {
  %c4 = scalar.constant 4 : i64
  %bytes = scalar.muli %index, %c4 : i64
  %o = func.call @off(%bytes) : (i64) -> (offset)
  %v = buffer.view %buf[%o] : buffer -> view<1xi32>
  view.store %value, %v[0] : i32, view<1xi32>
  func.return
}

func.def @set_i64(%buf: buffer, %index: i64, %value: i64) {
  %c8 = scalar.constant 8 : i64
  %bytes = scalar.muli %index, %c8 : i64
  %o = func.call @off(%bytes) : (i64) -> (offset)
  %v = buffer.view %buf[%o] : buffer -> view<1xi64>
  view.store %value, %v[0] : i64, view<1xi64>
  func.return
}

func.def @put(%out: buffer, %pos: i64, %b: i8) -> (i64) {
  %length = buffer.length %out
  %cap = index.cast %length : offset to i64
  %ok = scalar.cmpi ult, %pos, %cap : i64
  %message = global.load @msg_capacity : buffer
  func.call @fail_unless(%ok, %message) : (i1, buffer)
  %o = func.call @off(%pos) : (i64) -> (offset)
  %v = buffer.view %out[%o] : buffer -> view<1xi8>
  view.store %b, %v[0] : i8, view<1xi8>
  %c1 = scalar.constant 1 : i64
  %next = scalar.addi %pos, %c1 : i64
  func.return %next : i64
}

func.def @put_range(%out: buffer, %pos: i64, %src: buffer, %src_offset: i64, %count: i64) -> (i64) {
  %c0 = scalar.constant 0 : i64
  %length = buffer.length %out
  %cap = index.cast %length : offset to i64
  %end = scalar.addi %pos, %count : i64
  %ok = scalar.cmpi ule, %end, %cap : i64
  %message = global.load @msg_capacity : buffer
  func.call @fail_unless(%ok, %message) : (i1, buffer)
  %some = scalar.cmpi sgt, %count, %c0 : i64
  scf.if %some {
    %so = func.call @off(%src_offset) : (i64) -> (offset)
    %po = func.call @off(%pos) : (i64) -> (offset)
    %bytes = func.call @off(%count) : (i64) -> (offset)
    buffer.copy %src[%so], %out[%po], %bytes
