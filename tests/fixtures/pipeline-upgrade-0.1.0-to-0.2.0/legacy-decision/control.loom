func.def @fail_unless(%condition: i1, %message: buffer) {
  %condition32 = scalar.extui %condition : i1 to i32
  func.call @require(%condition32, %message) : (i32, buffer)
  func.return
}

func.def @off(%v: i64) -> (offset) {
  %b = scalar.assume %v [range(%v, 0, 9223372036854775807)] : i64
  %o = index.cast %b : i64 to offset
  func.return %o : offset
}

func.def @ix(%v: i64) -> (index) {
