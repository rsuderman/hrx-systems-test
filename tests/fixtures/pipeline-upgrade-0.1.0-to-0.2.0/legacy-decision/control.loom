  %v = buffer.view %buf[%o] : buffer -> view<1xi8>
  %b = view.load %v[0] : view<1xi8> -> i8
  func.return %b : i8
}

func.def @i32_at(%buf: buffer, %index: i64) -> (i32) {
  %c4 = scalar.constant 4 : i64
  %bytes = scalar.muli %index, %c4 : i64
  %o = func.call @off(%bytes) : (i64) -> (offset)
  %v = buffer.view %buf[%o] : buffer -> view<1xi32>
  %x = view.load %v[0] : view<1xi32> -> i32
  func.return %x : i32
}

func.def @i64_at(%buf: buffer, %index: i64) -> (i64) {
