// Decision service v1 roles.
func.decl @prepare(%directory: buffer, %options: buffer) -> (i64, i64, i64, i64, buffer, buffer, buffer)

func.def public @decision_prepare_v1(%directory: buffer, %options: buffer) -> (i64, i64, i64, i64, buffer, buffer, buffer) {
  %r0, %r1, %r2, %r3, %r4, %r5, %r6 = func.call @prepare(%directory, %options) : (buffer, buffer) -> (i64, i64, i64, i64, buffer, buffer, buffer)
  func.return %r0, %r1, %r2, %r3, %r4, %r5, %r6 : i64, i64, i64, i64, buffer, buffer, buffer
}

func.decl @prepare_request(%state: buffer, %request: buffer) -> (buffer, i64, i64)

func.def public @decision_prepare_request_v1(%state: buffer, %request: buffer) -> (buffer, i64, i64) {
  %r0, %r1, %r2 = func.call @prepare_request(%state, %request) : (buffer, buffer) -> (buffer, i64, i64)
  func.return %r0, %r1, %r2 : buffer, i64, i64
}

func.decl @prepare_batch(%state: buffer, %tags: buffer, %ranges: buffer, %packed: buffer) -> (i32, buffer, buffer)

func.def public @decision_prepare_batch_v1(%state: buffer, %tags: buffer, %ranges: buffer, %packed: buffer) -> (i32, buffer, buffer) {
  %r0, %r1, %r2 = func.call @prepare_batch(%state, %tags, %ranges, %packed) : (buffer, buffer, buffer, buffer) -> (i32, buffer, buffer)
  func.return %r0, %r1, %r2 : i32, buffer, buffer
}

func.decl @run(%stage: i32, %input: hal.buffer, %output: hal.buffer)

func.def public @decision_run_v1(%stage: i32, %input: hal.buffer, %output: hal.buffer) {
  func.call @run(%stage, %input, %output) : (i32, hal.buffer, hal.buffer)
  func.return
}
